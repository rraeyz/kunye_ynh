generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        Int      @id @default(1)
  name      String   @default("Your Name")
  bio       String   @default("Your bio goes here")
  imageUrl  String   @default("/default-avatar.jpg")
  
  // SEO & Social Media
  pageTitle       String @default("Personal Link Tree")
  pageDescription String @default("Welcome to my link tree")
  ogImageUrl      String @default("")
  faviconUrl      String @default("") // Site favicon (browser tab icon)
  
  // Theme Settings
  themePreset     String @default("purple-dream")
  primaryColor    String @default("#a855f7")
  accentColor     String @default("#ec4899")
  backgroundColor String @default("#0a0a0a")
  cardColor       String @default("#1a1a1a")
  textColor       String @default("#ffffff")
  buttonStyle     String @default("gradient") // gradient, solid, outline, glass
  fontFamily      String @default("Inter")
  borderRadius    String @default("xl") // sm, md, lg, xl, 2xl, full
  animationSpeed  String @default("normal") // slow, normal, fast
  
  // Background Settings
  backgroundType  String @default("gradient-blur") // solid, gradient-blur, particles, image, mesh-gradient
  backgroundImage String @default("") // URL for custom background image
  backgroundOpacity Int   @default(100) // 0-100

  // Sayfa düzeni
  coverImage      String @default("") // Profilin üstündeki kapak görseli
  layout          String @default("classic") // classic (liste) | grid (bento ızgara)

  // Profil kartı (sitede solda / telefonda üstte duran bölüm)
  statusText        String  @default("") // "Şu an: ..." satırı; boşsa görünmez
  location          String  @default("") // Şehir/ülke; boşsa görünmez
  timezone          String  @default("") // IANA saat dilimi (Europe/Istanbul); boşsa yerel saat görünmez
  showContactButton Boolean @default(true) // "Bana yaz" (iletişim formu); e-posta + SMTP ayarlı değilse zaten gizli
  showShareButton   Boolean @default(true)
  showNewsletter    Boolean @default(true) // Bülten abonelik kutusu
  showCategoryTabs  Boolean @default(true) // Linklerde 2+ kategori varsa üstte sekmeler
  showViewCounter   Boolean @default(false) // Sayfanın altında "X kez görüntülendi"

  // "Bu hafta / şu an" duyurusu: sayfanın üstünde; bitiş tarihi geçince kendiliğinden kaybolur
  announcementText  String    @default("")
  announcementUrl   String    @default("")
  announcementUntil DateTime?

  // Bakım modu: ziyaretçiler yalnızca bakım mesajını görür, admin siteyi normal görür
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("")
  
  // Contact Settings
  contactEmail    String @default("")
  contactPhone    String @default("")
  contactAddress  String @default("")
  showVCard       Boolean @default(false) // Ziyaretçilere "Rehbere Ekle" (vCard) butonu göster
  
  // Appearance Settings
  darkMode        Boolean @default(true) // Dark/Light mode toggle
  
  // Verification & Badges
  verified        Boolean @default(false)
  badges          String  @default("") // JSON array of badge names
  
  // Analytics Settings
  analyticsRetentionDays Int @default(90) // 0 = forever, >0 = days to keep
  
  // Email Settings (SMTP)
  smtpHost        String @default("")
  smtpPort        Int    @default(587)
  smtpUser        String @default("")
  smtpPassword    String @default("")
  smtpFrom        String @default("")
  smtpFromName    String @default("") // Gönderen adı (örn: "Rraeyz Destek Ekibi")
  smtpSecure      Boolean @default(false) // true for 465, false for 587
  
  // Email Signature Settings
  companyName     String @default("")
  companyAddress  String @default("")
  linkedinUrl     String @default("")
  twitterUrl      String @default("")
  discordUrl      String @default("")
  youtubeUrl      String @default("")
  instagramUrl    String @default("")
  githubUrl       String @default("")
  showSocialIcons Boolean @default(true) // Sosyal medya linklerini ana sayfada ikon olarak göster

  // Bülten: açıksa yeni abone, e-postasındaki onay linkine tıklayana kadar "onay bekliyor" kalır
  newsletterDoubleOptIn Boolean @default(false)

  // Otomatik e-postalar (boşsa gönderilmez; SMTP ayarlı olmalı)
  contactAutoReply    String @default("") // "Bana yaz" ile yazana giden yanıt
  welcomeEmailSubject String @default("")
  welcomeEmailBody    String @default("") // Yeni (onaylı) aboneye giden hoş geldin e-postası

  // Otomatik işler (günde bir kez çalışır)
  autoBackupEnabled   Boolean @default(false) // Tam yedeği sunucuya kaydet (son 7 gün)
  weeklyReportEnabled Boolean @default(false) // Pazartesi haftalık özet e-postası
  linkHealthEnabled   Boolean @default(true)  // Link adreslerini kontrol et, kırıkları panelde göster

  // Bildirimler (yeni abone / iletişim mesajı). Boşsa gönderilmez
  notifyNtfyUrl        String @default("") // https://ntfy.sh/konu
  notifyTelegramToken  String @default("") // Bot token (istemciye gönderilmez)
  notifyTelegramChatId String @default("")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Link {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  icon      String   @default("FaLink")
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  
  // Link Type (normal link, contact form, donation, etc)
  type      String   @default("link") // link, contact, donation, embed-*, text, gallery, spotify, countdown, portfolio, heading, skills, coupon, testimonials, faq, timeline
  
  // Password Protection
  password  String   @default("") // Empty = no password, bcrypt hash if protected
  passwordHint String @default("") // Optional hint for users
  
  // Scheduling
  startDate DateTime? // Link becomes active from this date
  endDate   DateTime? // Link becomes inactive after this date
  
  // Short URL
  slug      String   @default("") // Custom short slug for /go/slug
  
  // Analytics
  clicks    Int      @default(0)
  
  // Categories
  category  String   @default("")

  // Görünüm ve blok içerikleri
  featured    Boolean  @default(false) // Öne çıkan link (büyük, vurgulu)
  thumbnail   String   @default("")    // Küçük önizleme görseli (link) / kart görseli (portfolio)
  description String   @default("")    // Metin bloğu içeriği, portfolyo/geri sayım açıklaması
  images      String   @default("")    // Galeri: JSON dizi olarak görsel adresleri
  targetDate  DateTime?                // Geri sayım hedef tarihi
  items       String   @default("")    // Liste blokları (SSS, referanslar, zaman çizelgesi, rozetler): JSON dizi
  price       String   @default("")    // Ürün kartı fiyatı (serbest metin: "₺250", "29 $")

  // Link sağlık kontrolü: 0 = kontrol edilmedi, HTTP durum kodu, -1 = ulaşılamadı
  healthStatus    Int       @default(0)
  healthCheckedAt DateTime?
  
  // Advanced Analytics
  analytics Analytics[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([category])
  @@index([slug])
}

model Analytics {
  id        Int      @id @default(autoincrement())
  linkId    Int
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  
  // Click Information
  timestamp DateTime @default(now())
  
  // Device & Browser
  userAgent String   @default("")
  device    String   @default("") // mobile, desktop, tablet
  browser   String   @default("") // chrome, firefox, safari, etc
  os        String   @default("") // windows, macos, linux, android, ios
  
  // Location (GeoIP)
  country   String   @default("")
  city      String   @default("")
  region    String   @default("")
  
  // Traffic Source
  referrer  String   @default("") // Where the user came from
  utmSource String   @default("") // UTM parameters
  utmMedium String   @default("")
  utmCampaign String @default("")
  utmTerm   String   @default("")
  utmContent String  @default("")
  
  // IP (hashed for privacy)
  ipHash    String   @default("")

  @@index([linkId])
  @@index([timestamp])
  @@index([country])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String   @default("")
  confirmed Boolean  @default(true) // E-posta onayı açıkken yeni aboneler onaylayana kadar false
  createdAt DateTime @default(now())
}

model Admin {
  id           Int      @id @default(1)
  username     String   @unique @default("admin")
  passwordHash String
  // Şifre değişince / "tüm cihazlardan çıkış" yapılınca artar; eski oturum token'ları geçersiz olur
  sessionVersion Int    @default(0)
  // İki adımlı doğrulama (TOTP). Boşsa kapalı
  totpSecret   String   @default("")
  totpRecovery String   @default("") // Tek kullanımlık kurtarma kodlarının SHA-256 özetleri (JSON dizi)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Profil sayfası görüntülenmeleri (tıklama oranı ve ziyaretçi sayısı için)
model PageView {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  device      String   @default("")
  browser     String   @default("")
  os          String   @default("")
  country     String   @default("")
  referrer    String   @default("")
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  ipHash      String   @default("")

  @@index([timestamp])
}

// Uygulamanın kendi iç durumu: kalıcı gizli anahtar, otomatik işlerin son çalışma zamanı vb.
// Yedeğe girmez.
// Kalıcı sayaçlar (ör. toplam sayfa görüntülenmesi: analitik verisi silinse de düşmez)
model Counter {
  key   String @id
  value Int    @default(0)
}

model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Admin giriş denemeleri (Ayarlar → Güvenlik). 90 günden eskiler silinir
model LoginEvent {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  success   Boolean
  reason    String   @default("") // ok | password | totp | rate-limit
  ip        String   @default("")
  userAgent String   @default("")

  @@index([timestamp])
}

// "Bana yaz" formundan gelen mesajlar (e-posta gönderilemese de kaybolmaz)
model ContactMessage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  emailed   Boolean  @default(false) // Admin'e e-posta olarak da gitti mi
  replies   ContactReply[]

  @@index([createdAt])
}

// Panelden mesaja gönderilen yanıtlar (konuşma geçmişi)
model ContactReply {
  id        Int            @id @default(autoincrement())
  messageId Int
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  body      String

  @@index([messageId])
}

// Abonelere gönderilen bültenlerin geçmişi
model NewsletterSend {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  subject    String
  recipients Int
  sent       Int
  failed     Int
}

// Geri al / ileri al: sayfa içeriğinin (profil, görünüm, bloklar) değişiklikten önceki hâli
model Revision {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  kind      String   // undo | redo
  label     String
  data      String

  @@index([kind])
}
